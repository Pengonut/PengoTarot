<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 离线/网络不稳时避免构建联网查包漏洞产生 NU1900 警告 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- ===== Multi-version compatibility ===== -->
  <PropertyGroup>
    <!-- Default: build for 110; override with /p:Sts2ApiCompat=0.107.0 -->
    <Sts2ApiCompat Condition="'$(Sts2ApiCompat)' == ''">0.110.0</Sts2ApiCompat>
    <!-- Strip patch version: 0.107.0 → 0.107, 0.110.0 → 0.110 -->
    <_PengoTarotCompatFolder>$([System.Version]::Parse('$(Sts2ApiCompat)').ToString(2))</_PengoTarotCompatFolder>
    <Sts2DllRoot>D:\[Tool] Godot\STS2dll\v$(_PengoTarotCompatFolder)</Sts2DllRoot>
    <!-- Isolate output per version (both obj and bin) -->
    <IntermediateOutputPath>.godot\mono\temp\obj\$(Configuration)\$(Sts2ApiCompat)\</IntermediateOutputPath>
    <OutputPath>.godot\mono\temp\bin\$(Configuration)\$(Sts2ApiCompat)\</OutputPath>
  </PropertyGroup>

  <Import Project="build\PengoTarot.CompatDefines.targets"/>

  <!-- Exclude loader sub-project from main compilation -->
  <ItemGroup>
    <Compile Remove="loader\**" />
    <Compile Remove="balatroeffect\Scripts\ShaderController_new.cs" />
    <!-- Game-source dependency files (for .tscn preview only, not compiled) -->
    <Compile Remove="src\Core\Nodes\GodotExtensions\**" />
    <Compile Remove="src\Core\Helpers\**" />
    <Compile Remove="src\Core\Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DllRoot)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DllRoot)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2DllRoot)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>